{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES2022",
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowSyntheticDefaultImports": true,
		"types": ["node"],
		"lib": ["ES2022", "DOM"]
	},
	"include": [
		"esbuild.config.ts",
		"vitest.config.ts",
		"eslint.config.mts",
		"scripts/**/*.ts",
		"test/**/*.ts"
	]
}
